; Engine configuration file.
; Aether Drift - 2.5D Procedural Co-op RPG MVP

config_version=5

[application]

config/name="Tiara"
config/description="Tiara — procedural co-op narrative RPG"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Bus="*res://core/event_bus.gd"
Audio="*res://core/audio.gd"
ThemeLoader="*res://core/theme_loader.gd"
PostFX="*res://ui/postfx_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

